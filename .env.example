# Production secrets / runtime configuration for docker-compose.yml.
# Values marked "set ..." are required; others have sensible defaults.

## Postgres container
POSTGRES_PASSWORD=set-a-strong-postgres-password
POSTGRES_DB=conduit_production
POSTGRES_PORT=5432

## Backend / application
JWT_KEY=set-a-long-random-jwt-secret
CORS_ORIGIN=https://your-domain.example
TRUST_PROXY=1
PROD_DB_SSL=false

## Production database
PROD_DB_USERNAME=postgres
PROD_DB_PASSWORD=set-a-strong-postgres-password
PROD_DB_NAME=conduit_production
PROD_DB_HOSTNAME=postgres
PROD_DB_PORT=5432
PROD_DB_DIALECT=postgres
PROD_DB_LOGGING=false
